# Copy to `.env` and fill with real values. `.env` is gitignored.

# --- MySQL (Railway) ---
# Either provide the full URL...
DATABASE_URL=mysql://user:password@host:3306/dbname
# ...or the discrete fields (server/db will read whichever is set).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
# Session length = minutes of INACTIVITY before auto sign-out.
# The client slides this forward while the user is interacting.
SESSION_IDLE_MINUTES=30
JWT_REFRESH_TTL=7d

# --- Cloudinary (file & photo storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Face Recognition API (external service) ---
# Base URL of the FastAPI face-recognition service (no trailing slash).
FACE_API_URL=http://13.126.157.145:8000
# Optional API key sent as the x-api-key header; leave blank if the API is open.
FACE_API_KEY=

# --- Concept Kitchen master-data API (external source of truth for masters) ---
# Base URL of the CK API (no trailing slash). Auth is a single `AuthKey` header.
CK_API_URL=https://api.conceptkitchen.net
CK_API_KEY=

# --- Server ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
